{
  "name": "clipforge",
  "private": true,
  "version": "0.1.0",
  "description": "Площадка для нарезки стримов Twitch на вертикальные клипы",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cf": "tsc -b apps/cli && node apps/cli/dist/main.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @clipforge/db push",
    "db:studio": "pnpm --filter @clipforge/db studio",
    "build": "turbo run build",
    "api": "pnpm --filter @clipforge/api start",
    "worker": "pnpm --filter @clipforge/worker start",
    "enqueue": "pnpm --filter @clipforge/worker enqueue",
    "web": "pnpm --filter @clipforge/web dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "node scripts/start.mjs",
    "test:integration": "node apps/api/test/access.integration.mjs && node apps/worker/test/queue.integration.mjs",
    "check:integrations": "pnpm --filter @clipforge/worker build && node apps/worker/dist/check-integrations.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.25.12",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
