# Private configuration: never commit the filled file.
DATABASE_URL=postgres://clipforge:REPLACE@YOUR_PRIVATE_DB_HOST:5432/clipforge?sslmode=require
WORKER_ROLE=media
WORKER_FLEET=true
WORKER_NAME=Media worker
WORKER_DB_POOL_SIZE=6
WORKER_QUEUE_POOL_SIZE=3
# Set WORKER_ID only if you need a stable name; each container must have a unique ID.
MEDIA_DOWNLOAD_KBPS=10000
MEDIA_UPLOAD_KBPS=5000
MEDIA_CPU_TARGET=90
MIN_FREE_GB=20
# Optional specialization. Omit to serve all queues available to this role.
# WORKER_QUEUES=heavy.pipeline,heavy.prepare-streamer,heavy.prepare-batch-vod
RENDER_CONCURRENCY=1
SPEECH_MODEL=large-v3
SPEECH_DEVICE=cpu
# Same object storage as the platform. Required for independent machines.
S3_ENDPOINT=https://YOUR_S3_ENDPOINT
S3_REGION=auto
S3_BUCKET=clipforge
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
# Optional Twitch metadata and YouTube uploads; use the same OAuth application.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
