# Порт нестандартный: 5432 на машине разработчика часто уже занят.
DATABASE_URL=postgresql://clipforge:clipforge@127.0.0.1:55432/clipforge

# Интерпретатор для python-воркеров. Оставлен venv текущего проекта:
# в нём уже стоят CUDA-библиотеки для CTranslate2.
PYTHON_BIN=.venv/Scripts/python.exe

API_PORT=8420
WEB_PORT=3000

# Каталоги данных. Общие для бэкенда и воркеров.
DATA_ROOT=data
OUT_ROOT=out
ASSETS_ROOT=assets
MODELS_ROOT=models

# Twitch: нужен для поиска стримеров и статуса эфира. Регистрация
# приложения бесплатная: dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Секрет для подписи сессионных cookie.
SESSION_SECRET=change-me

# Первый администратор, только при новой БД
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8420
# Twitch callback: http://localhost:3000/api/twitch/callback
LANGUAGES=ru
AUTOMATION_MINUTES=10
DISCOVERY_MINUTES=30
INDEX_STALE_MINUTES=30
AUTO_ADD_SCORE=0.55
AUTO_ADD_LIMIT=1
AUTO_VODS_PER_DAY=3
AUTO_MAX_VOD_HOURS=4
CLIPS_PER_RUN=24
MIN_FREE_GB=20
SOURCE_RETENTION_DAYS=2
SPEECH_MODEL=large-v3
SPEECH_LANGUAGE=ru
SPEECH_BATCH_SIZE=1
SPEECH_WINDOW_SECONDS=300
SPEECH_COMPUTE_TYPE=int8_float16
SPEECH_CPU_THREADS=2
RENDER_CONCURRENCY=1
MEDIA_NETWORK_KBPS=10000
MEDIA_MEMORY_MB=4096
MEDIA_MIN_FREE_MB=8192
MEDIA_CPU_PERCENT=20
# YouTube callback: http://localhost:8420/api/platforms/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
AUTO_PUBLISH_ENABLED=false
YOUTUBE_PRIVACY=private
YOUTUBE_DAILY_LIMIT=100
